# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# dumps do banco de produção (pg_dump) - dados sensíveis, nunca versionar
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local session state - never share between sessions/agents
.claude/settings.local.json
.claude/worktrees/

# fallback local de auditoria (src/lib/audit.ts) - nunca versionar, pode conter dado sensível
/logs/

# workspace de execução do subagent-driven-development (ledger, briefs, reports por plano)
/.superpowers/

# planilhas de trabalho usadas para testar importações - dado de negócio, nunca versionar
*.xlsx
*.xls
